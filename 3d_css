// --- [ 主场景：组装所有 3D 元素 ] ---
export default function Cockpit3DScene() {
  const [mousePos, setMousePos] = useState({ x: 0, y: 0 });

  // 监听鼠标移动，转换为视角的旋转角度 (限制在 ±15 度以内)
  const handleMouseMove = (e) => {
    const x = (e.clientX / window.innerWidth - 0.5) * 30; // 左右晃动
    const y = (e.clientY / window.innerHeight - 0.5) * 30; // 上下晃动
    setMousePos({ x, y });
  };

  return (
    // 1. 最外层容器：设置 perspective (透视视距)，数值越小畸变越大，1000px比较自然
    <div 
      className="w-full h-screen bg-[#050505] overflow-hidden flex items-center justify-center relative cursor-crosshair select-none"
      style={{ perspective: '1200px' }}
      onMouseMove={handleMouseMove}
    >
      <div className="absolute top-4 left-4 text-white/30 font-mono text-xs z-50 pointer-events-none">
        MOVE MOUSE TO LOOK AROUND
      </div>

      {/* 2. 摄像机云台：响应鼠标移动，旋转整个场景 */}
      <div 
        className="relative w-full h-full"
        style={{ 
          // 鼠标上下移动改变 rotateX，左右移动改变 rotateY
          transform: `rotateX(${-mousePos.y}deg) rotateY(${mousePos.x}deg)`,
          transformStyle: 'preserve-3d',
          transition: 'transform 0.1s ease-out' // 稍微加一点延迟，让转动更柔和
        }}
      >
        
        {/* === 空间元素 1：挡风玻璃声纳 === */}
        <SonarScreen />

        {/* === 空间元素 2：中控台基座 === */}
        {/* 这个基座整体向后倾斜 20 度，模拟真实的汽车仪表台斜度 */}
        <div 
          className="absolute top-[50%] left-1/2 w-[800px] h-[300px] -ml-[400px]"
          style={{ 
            transform: 'translateY(100px) translateZ(0px) rotateX(-20deg)',
            transformStyle: 'preserve-3d' 
          }}
        >
          {/* 中控台的黑色底座背景 */}
          <div className="absolute inset-[-50px] bg-zinc-900 border-t-[10px] border-zinc-950 shadow-[0_50px_100px_rgba(0,0,0,1)] rounded-t-[50px] opacity-90" style={{ transform: 'translateZ(-10px)' }}></div>
          
          <StatusPanel />
          <RadioPanel />
          <DrivePanel />
        </div>

        {/* === 空间元素 3：悬浮方向盘 (离你最近) === */}
        {/* 通过高 translateZ 让它突出屏幕，贴近玩家 */}
        <div 
          className="absolute top-1/2 left-1/2 w-[450px] h-[450px] -ml-[225px] -mt-[100px]"
          style={{ 
            transform: 'translateY(250px) translateZ(300px) rotateX(-10deg)',
            transformStyle: 'preserve-3d' 
          }}
        >
           {/* 方向盘外圈 */}
           <div className="w-full h-full rounded-full border-[35px] border-zinc-900 shadow-[0_30px_50px_rgba(0,0,0,0.9),inset_0_5px_15px_rgba(255,255,255,0.1)] relative">
              {/* 方向盘辐条 */}
              <div className="absolute top-1/2 left-0 w-full h-[60px] -mt-[30px] bg-zinc-800 border-y-4 border-zinc-700 shadow-xl flex items-center justify-center">
                 <div className="w-[100px] h-[100px] rounded-full bg-zinc-950 border-4 border-zinc-700 shadow-inner flex items-center justify-center">
                    <span className="text-zinc-500 font-bold text-sm tracking-widest">A.E.S</span>
                 </div>
              </div>
              <div className="absolute bottom-0 left-1/2 w-[60px] h-[50%] -ml-[30px] bg-zinc-800 border-x-4 border-zinc-700 shadow-xl"></div>
           </div>
        </div>

      </div>
    </div>
  );
}